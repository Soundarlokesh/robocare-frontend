# Copy to .env.local. Only NEXT_PUBLIC_* values are visible in the browser; never put secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Digits with country code, no plus sign. Leave empty until the business number is confirmed.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_EMAIL=

